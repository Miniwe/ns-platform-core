{
  "name": "@miniwe/ns-platform-core",
  "version": "1.0.10",
  "description": "Reusable NestJS platform core for backend services",
  "keywords": [
    "nest",
    "services",
    "ssot",
    "guards",
    "ect"
  ],
  "homepage": "https://github.com/Miniwe/ns-platform-core#readme",
  "bugs": {
    "url": "https://github.com/Miniwe/ns-platform-core/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Miniwe/ns-platform-core.git"
  },
  "license": "ISC",
  "author": "Vitaly Dryukov (miniwe@mail.ru)",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo coverage allure-results allure-report",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contracts",
    "test:debug-handles": "jest --config qa/jest.unit.config.cjs --runInBand --detectOpenHandles",
    "test:unit": "jest --config qa/jest.unit.config.cjs",
    "test:unit:cov": "jest --config qa/jest.unit.config.cjs --coverage",
    "test:integration": "jest --config qa/jest.integration.config.cjs --runInBand",
    "test:contracts": "jest --config qa/jest.contract.config.cjs",
    "test:dependencies": "npx dependency-cruiser src -c .dependency-cruiser.js",
    "test:smoke": "jest --config qa/jest.smoke.config.cjs --runInBand",
    "report:open": "allure open allure-report",
    "report:single": "allure generate allure-results --single-file -o allure-report --clean",
    "report:generate": "allure generate allure-results -o allure-report --clean",
    "docs": "typedoc",
    "knip": "npx knip",
    "prepublishOnly": "npm run clean && npm run lint && npm run test:dependencies && npm run test:all && npm run build && npm pack && rm miniwe-ns-platform-core-*.tgz",
    "husky": "husky install"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.30",
    "zod": "^4.4.0"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "allure": "^3.8.2",
    "bullmq": "^5.76.8",
    "cache-manager": "^7.2.8",
    "dataloader": "^2.2.3",
    "decimal.js": "^10.6.0",
    "nestjs-zod": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/redis": "^10.28.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.3",
    "allure-commandline": "^2.42.0",
    "allure-jest": "^3.9.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fastify": "^5.8.5",
    "globals": "^17.6.0",
    "husky": "^8.0.0",
    "jest": "^30.4.2",
    "jest-allure2-reporter": "^2.3.0",
    "knip": "^6.14.2",
    "rimraf": "^6.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.60.0"
  }
}
