{
  "name": "@miniwe/ns-platform-core",
  "version": "1.1.31",
  "devbuild": "141",
  "description": "Reusable NestJS platform core for backend services",
  "keywords": [
    "nest",
    "services",
    "ssot",
    "guards",
    "ect"
  ],
  "homepage": "https://github.com/Miniwe/ns-platform-core#readme",
  "bugs": {
    "url": "https://github.com/Miniwe/ns-platform-core/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Miniwe/ns-platform-core.git"
  },
  "license": "ISC",
  "author": "Vitaly Dryukov (miniwe@mail.ru)",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./access": {
      "types": "./dist/access/index.d.ts",
      "require": "./dist/access/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "require": "./dist/auth/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "require": "./dist/config/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "require": "./dist/context/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "require": "./dist/database/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "require": "./dist/events/index.js"
    },
    "./filters": {
      "types": "./dist/filters/index.d.ts",
      "require": "./dist/filters/index.js"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "require": "./dist/guards/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "require": "./dist/schemas/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "require": "./dist/security/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "require": "./dist/services/index.js"
    },
    "./transformers": {
      "types": "./dist/transformers/index.d.ts",
      "require": "./dist/transformers/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo coverage allure-results allure-report",
    "cleanPrePublish": "npm run clean && rimraf package-lock.json node_modules",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:watch": "tsc-watch -p tsconfig.build.json --onSuccess \"npm run fix-dev\"",
    "fix-dev": "tsc-alias -p tsconfig.build.json && node scripts/increment-build.js",
    "noemit": "npx tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contracts",
    "test:debug-handles": "jest --config qa/jest.unit.config.cjs --runInBand --detectOpenHandles",
    "test:unit": "jest --config qa/jest.unit.config.cjs",
    "test:unit:cov": "jest --config qa/jest.unit.config.cjs --coverage",
    "test:integration": "jest --config qa/jest.integration.config.cjs --runInBand",
    "test:contracts": "jest --config qa/jest.contract.config.cjs",
    "test:dependencies": "npx dependency-cruiser src -c .dependency-cruiser.js",
    "test:smoke": "jest --config qa/jest.smoke.config.cjs --runInBand",
    "report:open": "allure open allure-report",
    "report:single": "allure generate allure-results --single-file -o allure-report --clean",
    "report:generate": "allure generate allure-results -o allure-report --clean",
    "docs": "typedoc",
    "knip": "npx knip",
    "prepublishOnly": "npm run cleanPrePublish && npm install && npm run lint && npm run test:dependencies && npm run test:all && npm run build && npm pack && rm miniwe-ns-platform-core-*.tgz",
    "prepare": "husky",
    "husky": "husky install"
  },
  "peerDependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.1",
    "bullmq": "^5.77.6",
    "cache-manager": "^7.2.8",
    "dataloader": "^2.2.3",
    "decimal.js": "^10.6.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.0",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^1.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/testing": "^11.1.24",
    "@nestjs/typeorm": "^11.0.1",
    "@testcontainers/postgresql": "^12.0.1",
    "@testcontainers/redis": "^12.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "allure": "^3.9.0",
    "allure-commandline": "^2.42.0",
    "allure-jest": "^3.9.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-allure2-reporter": "^2.3.0",
    "knip": "^6.15.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsc-watch": "^7.2.0",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typeorm": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
