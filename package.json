{
  "name": "@miniwe/ns-platform-core",
  "version": "1.0.0",
  "description": "Reusable NestJS platform core for backend services",
  "private": true,
  "keywords": [
    "nest",
    "services",
    "ssot",
    "guards",
    "ect"
  ],
  "homepage": "https://github.com/Miniwe/ns-platform-core#readme",
  "bugs": {
    "url": "https://github.com/Miniwe/ns-platform-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Miniwe/ns-platform-core.git"
  },
  "license": "ISC",
  "author": "Vitaly Dryukov (miniwe@mail.ru)",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./database": {
      "types": "./dist/database/index.d.ts",
      "require": "./dist/database/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "todo": {
    "./transactions": {
      "types": "./dist/transactions/index.d.ts",
      "require": "./dist/transactions/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "require": "./dist/auth/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "require": "./dist/permissions/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "require": "./dist/cache/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "require": "./dist/config/index.js"
    },
    "./error-handling": {
      "types": "./dist/error-handling/index.d.ts",
      "require": "./dist/error-handling/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist coverage allure-results allure-report",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration && npm run test:contracts",
    "test:unit": "jest --config qa/jest.unit.config.cjs --coverage",
    "test:integration": "jest --config qa/jest.integration.config.cjs --runInBand",
    "test:contracts": "jest --config qa/jest.contract.config.cjs",
    "test:smoke": "jest --config qa/jest.smoke.config.cjs --runInBand",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "docs": "typedoc",
    "knip": "npx knip",
    "prepublishOnly": "npm run clean && npm run lint && npm run test:all && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.29",
    "zod": "^4.4.0"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "bullmq": "^5.76.8",
    "cache-manager": "^7.2.8",
    "decimal.js": "^10.6.0",
    "nestjs-zod": "^5.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/redis": "^10.28.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.3",
    "allure-jest": "^3.9.0",
    "dependency-cruiser": "^17.4.0",
    "fastify": "^5.8.5",
    "jest": "^30.4.2",
    "jest-allure2-reporter": "^2.3.0",
    "knip": "^6.14.2",
    "rimraf": "^6.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
